# Story Journey
entity hero as person label "Hero" [role=lead]
entity village as place label "Village"
entity mountain as place label "Mountain"

rel hero -> village as begins_at
rel hero -> mountain as travels_to [difficulty=high]

flow ascent label "Mountain ascent"
{
  step wake uses hero label "Wake with purpose"
  step leave uses village label "Leave home"
  step climb uses mountain label "Climb toward the summit"
}
